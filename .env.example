# ============================================
# ChatGPT2API 环境变量配置示例
# ============================================
#
# 用法：
#   cp .env.example .env
#   cp config.example.json config.json      # 不先建这个文件，docker 会把它建成目录
#   docker compose up -d
#
# 三个 compose 文件的 app service 都带 `env_file: .env`（required: false），
# 因此本文件里的变量会原样注入容器；.env 不存在时也能启动。

# 认证密钥（必填）
# 未设置时 compose 会在启动前直接报错退出（${CHATGPT2API_AUTH_KEY:?...}），
# 而不是让容器因 config.py 抛 ValueError 反复重启。
CHATGPT2API_AUTH_KEY=your_secret_key_here

# 基础 URL（可选，用于生成图片 URL）
# CHATGPT2API_BASE_URL=https://your-domain.com

# 监听地址 / 端口
# - CHATGPT2API_HOST / CHATGPT2API_PORT 只对本机直接 `uv run main.py` 生效（默认 0.0.0.0:8000）
# - 容器内监听端口读的是 PORT（默认 80），compose 已固定为 80 并通过 8000:80 映射出去；
#   Render / Railway 这类自动注入 PORT 的平台无需额外配置
# CHATGPT2API_HOST=0.0.0.0
# CHATGPT2API_PORT=8000
# PORT=80

# 访问日志开关（可选，默认开）
# CHATGPT2API_ACCESS_LOG=true

# 并发连接数上限（可选，默认 256；0 表示不限制。防止慢连接 / 大 body 耗尽事件循环）
# CHATGPT2API_LIMIT_CONCURRENCY=256

# 数据目录 / 配置文件位置（可选，默认为程序目录下的 data/ 与 config.json）
# 同机跑第二个实例、或本地验证不想碰正在用的号池时，指向另一份目录即可。
# 容器里保持默认：compose 挂载的就是 /app/data 与 /app/config.json。
# CHATGPT2API_DATA_DIR=/srv/chatgpt2api-2/data
# CHATGPT2API_CONFIG_FILE=/srv/chatgpt2api-2/config.json

# ============================================
# 存储后端配置
# ============================================

# 存储后端类型（可选值: json, sqlite, postgres, git）
# 默认: json
STORAGE_BACKEND=json

# ============================================
# 数据库配置（当 STORAGE_BACKEND=sqlite/postgres 时使用）
# ============================================

# PostgreSQL 示例
# DATABASE_URL=postgresql://user:password@localhost:5432/chatgpt2api

# Supabase 示例
# DATABASE_URL=postgresql://postgres.xxx:password@aws-1-us-west-1.pooler.supabase.com:5432/postgres

# SQLite 示例（不指定时自动使用 data/accounts.db）
# DATABASE_URL=sqlite:///app/data/accounts.db

# ============================================
# Git 仓库配置（当 STORAGE_BACKEND=git 时使用）
# ============================================

# Git 仓库地址（必填）
# GIT_REPO_URL=https://github.com/your-username/your-private-repo.git

# Git 访问令牌（必填）
# GitHub: ghp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# GitLab: glpat-xxxxxxxxxxxxxxxxxxxx
# GIT_TOKEN=your_git_token_here

# Git 分支（可选，默认: main）
# GIT_BRANCH=main

# Git 仓库中的文件路径（可选，默认: accounts.json）
# GIT_FILE_PATH=accounts.json

# ============================================
# WARP / FlareSolverr 稳定代理配置（可选）
# ============================================

# docker-compose.warp.yml 暴露到宿主机的端口
# WARP_SOCKS_PORT=40000
# PRIVOXY_PORT=40080
# FLARESOLVERR_PORT=8191

# FlareSolverr 日志与时区
# FLARESOLVERR_LOG_LEVEL=info
# TZ=Asia/Shanghai

# Cloudflare WARP+ License Key（可选）
# WARP_LICENSE_KEY=

# 初始化 proxy_runtime 默认值
# CHATGPT2API_PROXY_RUNTIME_ENABLED=true
# CHATGPT2API_PROXY_RUNTIME_EGRESS_MODE=single_proxy
# CHATGPT2API_PROXY_RUNTIME_PROXY_URL=http://privoxy:8118
# CHATGPT2API_PROXY_RUNTIME_RESOURCE_PROXY_URL=
# CHATGPT2API_PROXY_RUNTIME_SKIP_SSL_VERIFY=false
# CHATGPT2API_PROXY_RUNTIME_RESET_STATUS_CODES=403

# Cloudflare clearance 刷新配置
# CHATGPT2API_PROXY_RUNTIME_CLEARANCE_ENABLED=true
# CHATGPT2API_PROXY_RUNTIME_CLEARANCE_MODE=flaresolverr
# CHATGPT2API_FLARESOLVERR_URL=http://flaresolverr:8191
# CHATGPT2API_PROXY_RUNTIME_CLEARANCE_TIMEOUT_SEC=60
# CHATGPT2API_PROXY_RUNTIME_CLEARANCE_REFRESH_INTERVAL=3600
# CHATGPT2API_PROXY_RUNTIME_WARM_UP_ON_START=false
# CHATGPT2API_PROXY_RUNTIME_BROWSER=chrome
# CHATGPT2API_PROXY_RUNTIME_USER_AGENT=

# ============================================
# 客户端环境画像（可选）
# ============================================
# 会话 payload 时区 / PoW 日期 / 语言默认按出口 IP 地理自动探测
# （主 ip-api.com 明文免费档，失败回退 ipwho.is；按代理出口缓存 6h）。
# 需要强制固定时再设置：
# OAI_CLIENT_TIMEZONE=Asia/Tokyo
# OAI_CLIENT_COUNTRY=JP

# ============================================
# waifu2x.net 非官方超分（可选）
# ============================================
# 网页对访客强制 Cloudflare Turnstile。不配打码密钥时，请求需自带 turnstile，
# 或填写 Patreon 登录后的 ses_id。详见 docs/waifu2x.md。
# WAIFU2X_BASE_URL=https://www.waifu2x.net
# WAIFU2X_TIMEOUT_SEC=180
# WAIFU2X_CAPSOLVER_KEY=
# WAIFU2X_TWOCAPTCHA_KEY=
# WAIFU2X_YESCAPTCHA_KEY=
# WAIFU2X_SES_ID=

# ============================================
# 豆包 / 360智图 非官方网页生图（可选）
# ============================================
# 人机验证一律外接：请求传 captcha，或 CAPTCHA_SOLVE_URL webhook，
# 或 Capsolver / 2Captcha / YesCaptcha。详见 docs/doubao.md、docs/zhitu360.md。
# CAPTCHA_SOLVE_URL=http://127.0.0.1:9000/solve
# CAPSOLVER_KEY=
# TWOCAPTCHA_KEY=
# YESCAPTCHA_KEY=
# DOUBAO_COOKIES=
# DOUBAO_A_BOGUS=
# DOUBAO_SOLVE_URL=
# ZHITU360_COOKIES=
# ZHITU360_SOLVE_URL=
